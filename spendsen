@app.get("/api/ml/evaluation")

def get_model_evaluation():

    if not REPORT_PATH.is_file():

        raise HTTPException(

            status_code=404,

            detail="Classifier report file not found.",

        )



    if not CONFUSION_MATRIX_PATH.is_file():

        raise HTTPException(

            status_code=404,

            detail="Confusion matrix file not found.",

        )



    try:

        with REPORT_PATH.open(

            "r", encoding="utf-8"

        ) as file:

            report = json.load(file)



        with CONFUSION_MATRIX_PATH.open(

            "r",

            encoding="utf-8-sig",

            newline="",

        ) as file:

            rows = list(csv.reader(file))



        if len(rows) < 2:

            raise ValueError(

                "Confusion matrix CSV is empty or incomplete."

            )



        labels = [

            label.strip()

            for label in rows[0][1:]

        ]



        if not labels:

            raise ValueError(

                "Confusion matrix has no category labels."

            )



        actual_labels = []

        matrix = []



        for row in rows[1:]:

            if not row:

                continue



            actual_labels.append(

                row[0].strip()

            )



            values = [

                int(value.strip())

                for value in row[1:]

            ]



            if len(values) != len(labels):

                raise ValueError(

                    "Confusion matrix row has incorrect dimensions."

                )



            matrix.append(values)



        if actual_labels != labels:

            raise ValueError(

                "Actual and predicted category labels do not match."

            )



        if len(matrix) != len(labels):

            raise ValueError(

                "Confusion matrix must be square."

            )



        total_samples = sum(

            sum(row) for row in matrix

        )



        correct_predictions = sum(

            matrix[i][i]

            for i in range(len(labels))

        )



        return {

            "model": {

                "name": "SpendSense Expense Classifier",

                "encoder": "all-MiniLM-L6-v2",

                "classifier": "Logistic Regression",

                "embedding_dimensions": 384,

            },

            "report": report,

            "confusion_matrix": {

                "labels": labels,

                "matrix": matrix,

                "total_samples": total_samples,

                "correct_predictions": correct_predictions,

            },

        }



    except (

        OSError,

        ValueError,

        json.JSONDecodeError,

    ) as exc:

        raise HTTPException(

            status_code=500,

            detail=f"Could not load ML evaluation: {exc}",

        ) from exc





