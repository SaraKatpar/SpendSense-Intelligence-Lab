def load_json_file(path, missing_message):

    if not path.is_file():

        raise HTTPException(

            status_code=503,

            detail=missing_message,

        )



    try:

        with path.open(

            "r", encoding="utf-8"

        ) as file:

            return json.load(file)



    except (OSError, ValueError) as exc:

        raise HTTPException(

            status_code=500,

            detail=f"Could not load model metadata: {exc}",

        ) from exc





